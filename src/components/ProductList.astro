---
import { bolProductlink, getProducten, productMelding } from '../lib/affiliate';

interface Props { ids?: string[]; titel?: string }
const { ids = [], titel = 'De pannen uit dit artikel' } = Astro.props;
const producten = getProducten(ids);
const heeftAmazon = producten.some((p) => p.affiliate && p.winkel === 'amazon');
---
{producten.length > 0 && (
<section class="product-list" aria-labelledby="producten-titel">
  <h2 id="producten-titel">{titel}</h2>
  <div class="product-grid">
    {producten.map((p) => (
      <article class="product-card">
        {p.winkel === 'bol'
          ? <Fragment set:html={bolProductlink(p)} />
          : <>
              <img src={p.afbeelding} alt={p.naam} width="400" height="400" loading="lazy" decoding="async">
              <h3>{p.naam}</h3>
              <a class="button button-outline" href={p.href} rel={p.affiliate ? 'sponsored nofollow noopener' : 'nofollow noopener'} target="_blank">Bekijk bij {p.winkelLabel}</a>
            </>}
        <p>{p.kort}</p>
        <p class="product-tip-melding">{productMelding(p)}</p>
      </article>
    ))}
  </div>
  {heeftAmazon && <p class="small muted">Als Amazon-partner verdien ik aan in aanmerking komende aankopen. <a href="/over-ons/#affiliate">Meer uitleg</a>.</p>}
</section>
)}

<script>
  // Het script van bol maakt zijn links pas na het laden en zet er geen rel op; dat doen we hier.
  for (const blok of document.querySelectorAll('.bol-productlink')) {
    const markeer = () => blok.querySelectorAll('a').forEach((a) => { a.rel = 'sponsored nofollow noopener'; });
    new MutationObserver(markeer).observe(blok, { childList: true, subtree: true });
  }
</script>
