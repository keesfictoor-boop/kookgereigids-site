---
import { getPosts } from '../lib/posts';

// De drie nieuwste artikelen verschijnen automatisch in de slider op de homepage.
const posts = (await getPosts()).slice(0, 3);
const pad = (n: number) => String(n).padStart(2, '0');
---
<div class="slider" role="region" aria-roledescription="carrousel" aria-label={`${posts.length} uitgelichte blogartikelen`}><div class="slider-track" tabindex="0" aria-label="Blogslider, scroll horizontaal of kies een artikelnummer">{posts.map((post, i) => (
<article class="slide" id={`verhaal-${i + 1}`} aria-label={`Artikel ${i + 1} van ${posts.length}`}><img src={post.data.image} alt={post.data.imageAlt} width="1200" height="900" loading="lazy" decoding="async" class="slide-image"><div class="slide-copy"><p class="eyebrow">{post.data.category}</p><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="slide-meta"><svg class="icon " viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2"/></svg>{post.data.readingTime} min leestijd</span><a class="text-link" href={`/blog/${post.id}/`}>Lees de gids<svg class="icon " viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div></article>
))}</div><div class="slider-navigation"><p>Een goed begin voor je volgende aankoop</p><nav class="slider-dots" aria-label="Kies een uitgelicht artikel">{posts.map((post, i) => <a href={`#verhaal-${i + 1}`} aria-label={`Toon artikel ${i + 1}: ${post.data.title}`}>{pad(i + 1)}</a>)}</nav></div></div>
