---
import Home from '../layouts/Home.astro';
import { getPosts } from '../lib/posts';

const meta = {
  "title": "Eerlijk advies over pannen en kookgerei | Kookgereigids",
  "description": "Pannen kiezen die bij jouw keuken passen. Eerlijk koopadvies van Kees uit Haarlem over pannensets, pannen voor inductie en koekenpannen.",
  "ogTitle": "Eerlijk advies over pannen en kookgerei",
  "ogDescription": "Pannen kiezen die bij jouw keuken passen. Eerlijk koopadvies van Kees uit Haarlem over pannensets, pannen voor inductie en koekenpannen.",
  "jsonLd": {
    "@type": "WebPage",
    "name": "Eerlijk advies over pannen en kookgerei",
    "description": "Pannen kiezen die bij jouw keuken passen. Eerlijk koopadvies van Kees uit Haarlem over pannensets, pannen voor inductie en koekenpannen.",
    "inLanguage": "nl-NL",
    "isPartOf": {
      "@type": "WebSite",
      "name": "Kookgereigids",
      "url": "https://kookgereigids.nl/"
    },
    "publisher": {
      "@id": "https://kookgereigids.nl/#organization"
    }
  }
};
const posts = await getPosts();
const leestijd = (id: string) => posts.find((post) => post.id === id)?.data.readingTime;
---
<Home {...meta}>
<section class="hero"><div><div class="eyebrow">Van thuiskok voor thuiskoks</div><h1>Minder zoeken.<br>Beter kiezen.<br><em>Lekker koken.</em></h1><p>De juiste pan maakt het verschil. Ik help je kiezen wat past bij jouw kookplaat, budget en manier van koken. Helder uitgelegd, zonder keuzestress.</p><div class="actions"><a class="button" href="/keuzehulp/">Help mij kiezen <span aria-hidden="true">→</span></a><a class="button secondary" href="#koopgidsen">Of bekijk de koopgidsen ↗</a></div><div class="micro"><span>In gewone taal</span><span>Van thuiskok voor thuiskoks</span></div></div><div class="hero-image"><img src="/assets/cooking.jpg" alt="Een roestvrijstalen koekenpan in gebruik op een kookplaat" width="1200" height="1800" fetchpriority="high"><div class="caption"><strong>Goed gereedschap.<br>Meer kookplezier.</strong><span>VAN DE EERSTE PANNENSET<br>TOT JE FAVORIETE KOEKENPAN</span></div></div></section>
<section class="categories" id="kiezen" aria-labelledby="choose-title"><div class="sectionhead"><div><div class="eyebrow">Waar begin jij?</div><h2 id="choose-title">Ik zoek een…</h2></div><p>Drie logische startpunten voor jouw volgende pan.</p></div><div class="choices"><div class="choice interactive-choice"><h3><a class="choice-link" href="/pannensets/"><span class="number">01 / EEN GOEDE BASIS</span><svg class="pan-icon" viewBox="0 0 80 48" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M15 16h46v22c0 4-4 6-8 6H23c-4 0-8-2-8-6V16ZM12 16h52M29 10h18M38 10V5M15 23H5v10h10M61 23h10v10H61M21 10h34"/></svg><span class="choice-title">Pannenset</span><span class="choice-description">Welke pannen heb je nodig, en welke set past bij je budget?</span><span class="choice-action">Lees de gids <span class="choice-arrow" aria-hidden="true">→</span></span></a></h3></div><div class="choice interactive-choice"><h3><a class="choice-link" href="/blog/koekenpan-kiezen/"><span class="number">02 / VOOR ELKE DAG</span><svg class="pan-icon" viewBox="0 0 80 48" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><ellipse cx="29" cy="25" rx="24" ry="12"/><path d="M5 25v8c0 7 48 7 48 0v-8M53 23l24-9v6l-24 9"/><ellipse cx="29" cy="25" rx="18" ry="8"/></svg><span class="choice-title">Koekenpan</span><span class="choice-description">Van RVS tot gietijzer: begrijp het verschil in materiaal en maat.</span><span class="choice-action">Lees de gids <span class="choice-arrow" aria-hidden="true">→</span></span></a></h3></div><div class="choice interactive-choice"><h3><a class="choice-link" href="/blog/pannen-inductie/"><span class="number">03 / OP JOUW KOOKPLAAT</span><svg class="pan-icon" viewBox="0 0 80 48" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M14 9h45v17c0 4-4 6-8 6H22c-4 0-8-2-8-6V9ZM59 13h11M14 13H4M9 39c6-5 12 5 18 0s12 5 18 0 12 5 18 0M9 46c6-5 12 5 18 0s12 5 18 0 12 5 18 0"/></svg><span class="choice-title">Pan voor inductie</span><span class="choice-description">Ontdek welke pannen werken op inductie en waar je op let.</span><span class="choice-action">Lees de gids <span class="choice-arrow" aria-hidden="true">→</span></span></a></h3></div></div></section>
<section class="guide-wizard" aria-labelledby="wizard-title"><div class="wizard-intro"><div class="eyebrow">Jouw keuken als vertrekpunt</div><h2 id="wizard-title">Waar begin je?</h2><p>Twee keuzes, een passende gids.</p><div class="wizard-progress" aria-label="Voortgang"><span id="wizard-step">Stap 1 van 2</span><div class="wizard-track"><span id="wizard-progress"></span></div></div></div><div class="wizard-main"><div id="wizard-question" role="group" aria-labelledby="wizard-question-title"><h3 id="wizard-question-title">Wat zoek je voor je keuken?</h3><div class="wizard-options" id="wizard-options"><button type="button" data-answer="set"><span>01</span>Een pannenset <b aria-hidden="true">→</b></button><button type="button" data-answer="frying"><span>02</span>Een koekenpan <b aria-hidden="true">→</b></button><button type="button" data-answer="induction"><span>03</span>Pannen voor inductie <b aria-hidden="true">→</b></button><button type="button" data-answer="basics"><span>04</span>De basis voor mijn keuken <b aria-hidden="true">→</b></button></div></div><div id="wizard-result" hidden><div class="eyebrow">Jouw startpunt</div><h3 id="wizard-result-title" tabindex="-1"></h3><p id="wizard-result-copy"></p><a class="button" id="wizard-result-link" href="/koopadvies/">Bekijk de gids →</a></div><div class="wizard-bottom"><button type="button" id="wizard-back" hidden>← Vorige keuze</button><span id="wizard-selection">Kies wat het beste bij je past.</span><button type="button" id="wizard-restart" hidden>Opnieuw beginnen ↺</button></div><span class="wizard-announcement" id="wizard-announcement" role="status" aria-live="polite"></span></div></section><section class="section guides" id="koopgidsen"><div class="sectionhead"><div><div class="eyebrow">Eerst even uitzoeken</div><h2>Een goed begin voor je aankoop.</h2></div><a class="textlink" href="/koopadvies/">Alle koopgidsen ↗</a></div><div class="articles"><a class="article" href="/blog/hoeveel-uitgeven-aan-een-pannenset/"><div class="image-wrap"><img src="/assets/spaghetti-kookpan.jpg" alt="Spaghetti gaat in een pan met kokend water" width="1280" height="853" loading="lazy" decoding="async"></div><div class="tag">Pannensets · Budget</div><h3>Wat geef je uit aan een goede pannenset?</h3><p>Waar het prijsverschil in zit en wanneer meer betalen zin heeft.</p><div class="meta"><span>{leestijd('hoeveel-uitgeven-aan-een-pannenset')} min leestijd</span><span>Lees de gids →</span></div></a><a class="article" href="/blog/koekenpan-kiezen/"><div class="image-wrap"><img src="/assets/biefstuk-gietijzeren-pan.jpg" alt="Biefstukken met rozemarijn in een gietijzeren pan" width="1280" height="853" loading="lazy" decoding="async"></div><div class="tag">Koekenpannen · Materialen</div><h3>Welke koekenpan past bij jouw manier van koken?</h3><p>Vergelijk materialen en ontdek welke maat je nodig hebt.</p><div class="meta"><span>{leestijd('koekenpan-kiezen')} min leestijd</span><span>Lees de gids →</span></div></a><a class="article" href="/blog/basis-pannen/"><div class="image-wrap"><img src="/assets/cooking.jpg" alt="Een koekenpan op de kookplaat" width="1200" height="1800" loading="lazy" decoding="async"></div><div class="tag">De basis · Slim kiezen</div><h3>Welke pannen heb je eigenlijk echt nodig?</h3><p>Een overzichtelijke basis voor je keuken, zonder een kast vol pannen.</p><div class="meta"><span>Praktische basisgids</span><span>Lees de gids →</span></div></a></div></section>
<section class="section kees" id="over" aria-labelledby="kees-title"><div class="kees-photo"><img src="/assets/wok-roerbak.jpg" alt="Roerbakgerecht met rundvlees, paprika en lente-ui in een wok" width="1280" height="853" loading="lazy" decoding="async"><div class="kees-photo-label"><span>UIT DE KEUKEN VAN KEES</span><strong>Voor het echte leven.<br>En de dagelijkse trek.</strong></div></div><div class="kees-content"><div class="eyebrow">Een thuiskok, net als jij</div><h2 id="kees-title">Een snelle wok.<br>Een grote pan soep.<br><em>Daar begint mijn advies.</em></h2><p>Hoi, ik ben Kees. Met mijn gezin in Haarlem en twee fulltime banen is koken bij ons geen uitgebreide voorstelling. Het is het moment waarop we samen iets lekkers op tafel zetten.</p><p>Dan wil je een pan die doet wat je nodig hebt. Daarom zoek ik uit wat materialen, maten en verschillen betekenen voor het koken van elke dag.</p><div class="kees-note"><span aria-hidden="true">↳</span><p>Ik zoek het uit.<br><strong>Jij maakt er iets lekkers van.</strong></p></div><div class="kees-bottom"><a class="textlink" href="/over-ons/">Meer over mij en mijn werkwijze ↗</a><span>Kees <small>THUISKOK UIT HAARLEM</small></span></div></div></section>
<section class="section faq" id="vragen"><div><div class="eyebrow">Even helder krijgen</div><h2>Dit wil je weten<br>voor je kiest.</h2><p>De eerste vragen op een rij. Verder lezen? Bij elk antwoord vind je de bijbehorende gids.</p></div><div><details><summary>Welke pannen heb ik echt nodig?</summary><p>Begin bij wat je kookt en voor hoeveel mensen. Een kookpan en koekenpan zijn een logisch vertrekpunt; een grotere pan of wok kan daarop aansluiten. <a href="/blog/basis-pannen/">Bekijk de basis voor jouw keuken.</a></p></details><details><summary>Welke pannen werken op inductie?</summary><p>Let op de vermelding van de fabrikant dat de pan geschikt is voor inductie en op de eisen van jouw kookplaat. <a href="/blog/pannen-inductie/">Lees waar je op moet letten.</a></p></details><details><summary>Wat is het verschil tussen de materialen?</summary><p>Materiaal bepaalt mede hoe een pan warmte opneemt, hoe je erin bakt en welk onderhoud nodig is. <a href="/blog/koekenpan-kiezen/">Vergelijk de materialen voor koekenpannen.</a></p></details><details><summary>Koop ik beter een set of losse pannen?</summary><p>Een set is vooral interessant als je de onderdelen ook gebruikt. Vul je een bestaande collectie aan, dan kan een losse pan beter aansluiten. <a href="/pannensets/">Lees de gids over pannensets.</a></p></details></div></section>
</Home>
<script>
(()=>{
const wizardData={
set:{label:'Pannenset',question:'Wat wil je vooral uitzoeken?',answers:[['budget','Wat mag een goede set kosten?'],['compare','Welke set past bij mijn keuken?']]},
frying:{label:'Koekenpan',question:'Waar twijfel je over?',answers:[['material','Het materiaal: RVS, gietijzer of anders'],['size','De maat en het dagelijks gebruik']]},
induction:{label:'Inductie',question:'Wat wil je weten over inductie?',answers:[['switch','Welke pannen zijn geschikt?'],['coating','Inductie én PFAS-vrij koken']]},
basics:{label:'Keukenbasis',question:'Waar sta je op dit moment?',answers:[['first','Ik richt mijn keuken voor het eerst in'],['less','Ik wil minder, maar bruikbare pannen']]}
};
function wizardRecommendation(topic,answer){
if(topic==='set'&&answer==='budget')return {title:'Wat kost een goede pannenset?',copy:'Begin met de prijsklassen en ontdek waar het verschil in zit. Zo kun je je budget gericht bepalen.',path:'blog/hoeveel-uitgeven-aan-een-pannenset/'};
if(topic==='set')return {title:'Een pannenset die bij je past.',copy:'Lees waar je op let bij het kiezen van een set: van de onderdelen tot het materiaal.',path:'pannensets/'};
if(topic==='frying')return {title:answer==='material'?'Begrijp het verschil tussen materialen.':'Kies een passende maat en uitvoering.',copy:'De koekenpangids helpt je materialen, maten en gebruik naast elkaar te leggen.',path:'blog/koekenpan-kiezen/'};
if(topic==='induction'&&answer==='coating')return {title:'Inductie en PFAS-vrij: waar let je op?',copy:'Lees verder over pannensets die aansluiten bij deze combinatie van wensen.',path:'blog/pannenset-inductie-pfas-vrij/'};
if(topic==='induction')return {title:'Een goed begin op inductie.',copy:'Ontdek waar je op moet letten bij de geschiktheid van je pannen voor inductie.',path:'blog/pannen-inductie/'};
return {title:answer==='less'?'Een overzichtelijke basis.':'Begin met de pannen die je echt gebruikt.',copy:'De basisgids helpt je bepalen wat je nodig hebt en welke aanvullingen later kunnen komen.',path:'blog/basis-pannen/'};
}
let wizardTopic=null,wizardStage=1;
const wizardOptions=document.getElementById('wizard-options'),wizardQuestion=document.getElementById('wizard-question'),wizardTitle=document.getElementById('wizard-question-title'),wizardResult=document.getElementById('wizard-result'),wizardBack=document.getElementById('wizard-back'),wizardRestart=document.getElementById('wizard-restart');
function renderWizardOptions(answers){wizardOptions.replaceChildren();answers.forEach(([value,label],index)=>{const button=document.createElement('button');button.type='button';button.dataset.answer=value;const number=document.createElement('span');number.textContent=String(index+1).padStart(2,'0');const arrow=document.createElement('b');arrow.setAttribute('aria-hidden','true');arrow.textContent='→';button.append(number,document.createTextNode(label),arrow);wizardOptions.append(button);});}
function renderWizard(focus=false){wizardQuestion.hidden=wizardStage===3;wizardResult.hidden=wizardStage!==3;wizardBack.hidden=wizardStage===1;wizardRestart.hidden=wizardStage===1;document.getElementById('wizard-step').textContent=wizardStage===3?'Jouw gids is gevonden':'Stap '+wizardStage+' van 2';document.getElementById('wizard-progress').style.width=wizardStage===1?'33%':wizardStage===2?'66%':'100%';document.getElementById('wizard-selection').textContent=wizardTopic?'Jouw keuze: '+wizardData[wizardTopic].label:'Kies wat het beste bij je past.';
if(wizardStage<3){wizardTitle.textContent=wizardStage===1?'Wat zoek je voor je keuken?':wizardData[wizardTopic].question;renderWizardOptions(wizardStage===1?[['set','Een pannenset'],['frying','Een koekenpan'],['induction','Pannen voor inductie'],['basics','De basis voor mijn keuken']]:wizardData[wizardTopic].answers);if(focus)wizardOptions.querySelector('button').focus();}document.getElementById('wizard-announcement').textContent=wizardStage===3?'Je passende gids staat klaar.':wizardTitle.textContent;}
wizardOptions.addEventListener('click',event=>{const button=event.target.closest('button[data-answer]');if(!button)return;const answer=button.dataset.answer;if(wizardStage===1){wizardTopic=answer;wizardStage=2;renderWizard(true);}else if(wizardStage===2){const result=wizardRecommendation(wizardTopic,answer);document.getElementById('wizard-result-title').textContent=result.title;document.getElementById('wizard-result-copy').textContent=result.copy;document.getElementById('wizard-result-link').href='/'+result.path;wizardStage=3;renderWizard();document.getElementById('wizard-result-title').focus();}});
wizardBack.addEventListener('click',()=>{wizardStage=Math.max(1,wizardStage-1);if(wizardStage===1)wizardTopic=null;renderWizard(true);});wizardRestart.addEventListener('click',()=>{wizardStage=1;wizardTopic=null;renderWizard(true);});

})();
</script>
