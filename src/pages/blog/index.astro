---
import Base from '../../layouts/Base.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getPosts } from '../../lib/posts';
const posts = await getPosts();
const meta = {
  "title": "Blog: pannen kiezen, inductie en een slimme basis | Kookgereigids",
  "description": "Lees praktische artikelen over welke pannen je nodig hebt, hoe je inductiegeschiktheid controleert en wanneer een pannenset of losse pannen passen.",
  "ogTitle": "Blog: pannen kiezen, inductie en een slimme basis",
  "ogDescription": "Lees praktische artikelen over welke pannen je nodig hebt, hoe je inductiegeschiktheid controleert en wanneer een pannenset of losse pannen passen.",
  "jsonLd": {
    "@type": "Blog",
    "name": "Blog: pannen kiezen, inductie en een slimme basis",
    "description": "Lees praktische artikelen over welke pannen je nodig hebt, hoe je inductiegeschiktheid controleert en wanneer een pannenset of losse pannen passen.",
    "inLanguage": "nl-NL",
    "isPartOf": {
      "@type": "WebSite",
      "name": "Kookgereigids",
      "url": "https://kookgereigids.nl/"
    },
    "publisher": {
      "@id": "https://kookgereigids.nl/#organization"
    }
  }
};
---
<Base {...meta} current="blog">
<nav class="container breadcrumb" aria-label="Broodkruimelpad"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Blog</span></nav><section class="container"><div class="page-heading"><p class="eyebrow">Het keukenschrift</p><h1>Een beetje wijzer.<br><em>Een stuk lekkerder koken.</em></h1><p class="lead">Praktische gidsen over pannen kiezen, koken op inductie en een slimme basis in je keuken. Geschreven door Kees, in gewone taal en met de bronnen erbij.</p></div><div class="blog-grid">{posts.map((post) => <BlogCard post={post} />)}</div></section>
<section class="editorial-band section" id="bronnen"><div class="container split"><div class="flow"><p class="eyebrow">Zo werk ik</p><h2>Goed uitgezocht,<br><em>gewoon uitgelegd.</em></h2><p class="muted">Ik haal mijn informatie bij fabrikanten, de Consumentenbond, overheidsinstanties zoals het RIVM en het Voedingscentrum, en waar het kan uit wetenschappelijk onderzoek. Daarna schrijf ik het op in gewone taal.</p><a class="text-link" href="/over-ons/#werkwijze">Meer over mijn werkwijze<svg class="icon " viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div></div></section><section class="closing-band"><div class="container closing-inner"><div><h2>Minder twijfelen. Meer lekker koken.</h2><p>Begin bij jouw kookgewoonten. De juiste pan volgt vanzelf.</p></div><a class="button button-light" href="/keuzehulp/">Ontdek jouw volgende pan<svg class="icon " viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div></section>
</Base>
