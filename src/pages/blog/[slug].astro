---
import { plaatsProducten } from '../../lib/affiliate';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';
import ProductList from '../../components/ProductList.astro';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const html = plaatsProducten(post.rendered?.html ?? '');
const d = post.data;
const jsonLd = {
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  inLanguage: 'nl-NL',
  datePublished: d.pubDate.toISOString().slice(0, 10),
  ...(d.updatedDate && { dateModified: d.updatedDate.toISOString().slice(0, 10) }),
  image: new URL(d.image, Astro.site).href,
  author: { '@type': 'Person', '@id': 'https://kookgereigids.nl/over-ons/#kees', name: 'Kees', url: 'https://kookgereigids.nl/over-ons/' },
  publisher: { '@id': 'https://kookgereigids.nl/#organization' },
};
---
<Base title={`${d.title} | Kookgereigids`} description={d.description} ogImage={d.image} ogType="article" jsonLd={jsonLd} current="blog">
<nav class="container breadcrumb" aria-label="Broodkruimelpad"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/blog/">Blog</a><span aria-hidden="true">/</span><span aria-current="page">{d.title}</span></nav>
<article class="article-section"><div class="container article-layout"><aside class="article-aside"><p class="eyebrow">In dit keukenschrift</p><nav aria-label={`Blogartikelen bij ${d.category}`}>{posts.slice(0, 8).map((p) => <a href={`/blog/${p.id}/`} aria-current={p.id === post.id ? 'location' : undefined}>{p.data.title}</a>)}</nav><hr><p class="small muted">Eerst begrijpen.<br>Dan pas kopen.</p></aside><div class="article-body"><span class={d.tagWarm ? 'tag tag-warm' : 'tag'}>{d.category}</span><h1>{d.title}</h1><div class="article-meta"><span>Door <a href="/over-ons/">Kees</a></span><span>{d.readingTime} min leestijd</span></div><p class="article-intro">{d.intro}</p><figure class="article-image"><img src={d.image} alt={d.imageAlt} width="1280" height="853" decoding="async" fetchpriority="high"></figure><Fragment set:html={html} /><ProductList ids={d.producten} /><a class="text-link" href="/keuzehulp/">Pas dit toe in jouw keuken<svg class="icon " viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div></div></article>
<section class="closing-band"><div class="container closing-inner"><div><h2>Minder twijfelen. Meer lekker koken.</h2><p>Begin bij jouw kookgewoonten. De juiste pan volgt vanzelf.</p></div><a class="button button-light" href="/keuzehulp/">Ontdek jouw volgende pan<svg class="icon " viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div></section>
</Base>
